# Copy to .env and fill in. NEVER commit .env.
# Generate strong values with:  openssl rand -hex 32

# ---- Public hostnames (point DNS A records at your server) ----
N8N_HOST=n8n.example.com
GATEWAY_HOST=hooks.example.com

# ---- PostgreSQL (n8n's database) ----
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n

# ---- MongoDB (gateway audit log) ----
MONGO_ROOT_USER=gateway
MONGO_ROOT_PASSWORD=change_me
MONGO_DB=webhooks

# ---- n8n ----
N8N_VERSION=latest            # pin to a tested version for production
N8N_ENCRYPTION_KEY=change_me  # encrypts stored credentials; losing it makes them unreadable
GENERIC_TIMEZONE=Africa/Nairobi

# ---- Gateway ----
# Value you set in the n8n Webhook node's Header Auth (header name: X-Gateway-Token)
N8N_GATEWAY_TOKEN=change_me
N8N_WEBHOOK_PATH=gateway-intake
REPLAY_TOLERANCE_SECONDS=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Provider signing secrets (leave blank to disable a provider)
STRIPE_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=
CUSTOM_WEBHOOK_SECRET=change_me
